   "rule": "Access",
   "details": "No external persons are allowed once the tournament kicks off."
  },
  {
   "rule": "Eligibility / payment",
   "details": "No weekly payment. Players must have paid the monthly ₦5,000 fee to be eligible."
  },
  {
   "rule": "Goalkeeper rotation",
   "details": "The designated “good keeper” rotates among each team."
  },
  {
   "rule": "Referee communication",
   "details": "Only the team captain may approach or complain to the referee."
  },
  {
   "rule": "Captain-rule penalty",
   "details": "After three violations by a team, the team is penalised and must choose one player to miss one minute of game time."
  },
  {
   "rule": "Incomplete team",
   "details": "If a team is incomplete before kick-off, it must choose to play with available players or forfeit. If forfeited, the opponent receives 3 points."
  },
  {
   "rule": "Arrival",
   "details": "Teams should arrive at least 15 minutes before kick-off."
  },
  {
   "rule": "Kits",
   "details": "Teams must wear distinguishable kits or bibs."
  },
  {
   "rule": "League scoring",
   "details": "Win = 3 points; draw = 1 point; loss = 0 points."
  },
  {
   "rule": "Tie-breakers",
   "details": "Points, then goal difference, then goals scored, then head-to-head points."
  },
  {
   "rule": "Competition format",
   "details": "No final or knockout stage. The team with the highest points after all fixtures wins."
  },
  {
   "rule": "Double fixtures in a day",
   "details": "If a team plays twice on a Sunday, those games must be in the first and last time slots."
  },
  {
   "rule": "Match length",
   "details": "15 minutes per half, 5-minute halftime, 35 minutes total; allow 5 minutes between matches."
  }
